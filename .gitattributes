# Enforce consistent line endings to prevent Windows CRLF vs Linux LF issues
# This stops extra blank lines in YAML, Kotlin, and other text files during ApplyPatch/editing

* text=auto

# Force LF in repository for all source and config files (critical for GitHub Actions)
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.gradle text eol=lf
*.gradle.kts text eol=lf
*.properties text eol=lf
*.md text eol=lf

# Binary files - no line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.apk binary
*.jar binary
*.keystore binary